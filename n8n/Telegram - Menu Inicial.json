    {
      "parameters": {
        "jsCode": "function fixBase64Padding(base64) {\n  let clean = base64.trim();\n  \n  if (clean.startsWith('data:image')) {\n    clean = clean.split('base64,')[1] || clean;\n  }\n  \n  let padding = 4 - (clean.length % 4);\n  if (padding !== 4) {\n    clean += '='.repeat(padding);\n  }\n  \n  clean = clean.replace(/[^A-Za-z0-9+/=]/g, '');\n  \n  return clean;\n}\n\nconst originalBase64 = items[0].json.qr_code_base64;\nconsole.log('Original base64 length:', originalBase64 ? originalBase64.length : 0);\nconsole.log('First 100 chars:', originalBase64 ? originalBase64.substring(0, 100) : 'none');\n\nif (!originalBase64) {\n  throw new Error('qr_code_base64 não encontrado');\n}\n\nconst fixedBase64 = fixBase64Padding(originalBase64);\nconsole.log('Fixed base64 length:', fixedBase64.length);\nconsole.log('É múltiplo de 4?', fixedBase64.length % 4 === 0);\n\nconst base64Regex = /^[A-Za-z0-9+/]*={0,3}$/;\nconsole.log('É base64 válido?', base64Regex.test(fixedBase64));\n\nreturn [{\n  json: {\n    ...items[0].json,\n    qr_code_base64_fixed: fixedBase64\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
